<%= form_with(model: pet) do |f| %>
  <% if pet.errors.any? %>
    <div class="alert alert-danger">
      <h2><%= pluralize(pet.errors.count, "error") %> prohibieron guardar esta mascota:</h2>
      <ul>
        <% pet.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= f.label :name, "Nombre", class: "form-label" %>
    <%= f.text_field :name, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= f.label :species, "Especie", class: "form-label" %>
    <%= f.text_field :species, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= f.label :breed, "Raza", class: "form-label" %>
    <%= f.text_field :breed, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= f.label :weight, "Peso (kg)", class: "form-label" %>
    <%= f.number_field :weight, step: :any, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= f.label :date_of_birth, "Fecha de Nacimiento", class: "form-label" %>
    <%= f.date_field :date_of_birth, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= f.label :owner_id, "Dueño", class: "form-label" %>
    <%= f.collection_select :owner_id, Owner.all, :id, :last_name, { prompt: "Seleccione un dueño" }, { class: "form-select" } %>
  </div>

  <%# --- CAMPO PARA LA FOTO (LAB 7) --- %>
  <div class="mb-3">
    <%= f.label :photo, "Foto de la Mascota", class: "form-label" %>
    <%= f.file_field :photo, class: "form-control" %>
  </div>

  <%= f.submit "Guardar Mascota", class: "btn btn-success" %>
<% end %>