<%= form_with(model: pet) do |f| %>
  <%= render 'shared/error_messages', object: f.object %>

  <div class="mb-3">
    <%= f.label :name, class: "form-label" %>
    <%= f.text_field :name, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= f.label :species, "Especie", class: "form-label" %>
    <%= f.select :species, ['dog', 'cat', 'rabbit', 'bird', 'reptile', 'other'], { prompt: 'Selecciona una especie' }, class: "form-select" %>
  </div>

  <div class="mb-3">
    <%= f.label :date_of_birth, class: "form-label" %>
    <%= f.date_field :date_of_birth, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= f.label :weight, class: "form-label" %>
    <%= f.number_field :weight, step: "0.1", class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= f.label :owner_id, "Dueño", class: "form-label" %>
    <%= f.collection_select :owner_id, Owner.all, :id, :last_name, { prompt: 'Selecciona un dueño' }, class: "form-select" %>
  </div>

  <%= f.submit class: "btn btn-success" %>
<% end %>