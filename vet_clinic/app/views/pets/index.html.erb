<div class="container">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Mascotas</h1>
    <%= link_to 'Nueva Mascota', new_pet_path, class: "btn btn-primary" %>
  </div>

  <table class="table table-hover">
    <thead class="table-light">
      <tr>
        <th>Foto</th>
        <th>Nombre</th>
        <th>Especie</th>
        <th>Dueño</th>
        <th>Acciones</th>
      </tr>
    </thead>
    <tbody>
      <% @pets.each do |pet| %>
        <tr>
          <td>
            <% if pet.photo.attached? %>
              <%= image_tag pet.photo.variant(resize_to_fill: [60, 60]), class: "rounded-circle border" %>
            <% else %>
              <div class="bg-light rounded-circle border d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                <span class="text-muted" style="font-size: 10px;">Sin foto</span>
              </div>
            <% end %>
          </td>
          <td><%= pet.name %></td>
          <td><%= pet.species %></td>
          <td><%= pet.owner.last_name if pet.owner %></td>
          <td>
            <%= link_to 'Ver', pet, class: "btn btn-sm btn-outline-info" %>
            <%= link_to 'Editar', edit_pet_path(pet), class: "btn btn-sm btn-outline-warning" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>