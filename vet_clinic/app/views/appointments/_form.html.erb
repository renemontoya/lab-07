<%= form_with(model: appointment) do |f| %>
  <div class="mb-3">
    <%= f.label :pet_id, "Mascota", class: "form-label" %>
    <%= f.collection_select :pet_id, Pet.all, :id, :name, { prompt: "Seleccione mascota" }, { class: "form-select" } %>
  </div>

  <div class="mb-3">
    <%= f.label :vet_id, "Veterinario", class: "form-label" %>
    <%= f.collection_select :vet_id, Vet.all, :id, :last_name, { prompt: "Seleccione veterinario" }, { class: "form-select" } %>
  </div>

  <div class="mb-3">
    <%= f.label :date, "Fecha y Hora", class: "form-label" %>
    <%= f.datetime_field :date, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= f.label :reason, "Motivo de la consulta", class: "form-label" %>
    <%= f.text_area :reason, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= f.label :status, "Estado", class: "form-label" %>
    <%= f.select :status, ['scheduled', 'completed', 'cancelled'], {}, { class: "form-select" } %>
  </div>

  <%= f.submit "Agendar Cita", class: "btn btn-primary" %>
<% end %>